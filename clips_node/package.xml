<?xml version="1.0"?>
<package format="3">
  <name>clips_node</name>
  <version>0.0.1</version>
  <description>Nodo ROS2 que ejecuta reglas CLIPS usando clipspy</description>

  <maintainer email="sergio@example.com">Sergio Cano</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>clipspy</exec_depend>
  <depend>clips_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
